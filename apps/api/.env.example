NODE_ENV=development
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://omni:change-me-before-any-shared-environment@localhost:5432/omni?schema=public
JWT_ISSUER=https://identity.example.com/
JWT_AUDIENCE=omni-api
JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
BILLING_WEBHOOK_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BILLING_WEBHOOK_SIGNATURE_HEADER=x-omni-signature
