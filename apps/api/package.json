{
  "name": "@omni/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "prebuild": "npm run prisma:generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.2",
    "@omni/contracts": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.10.0",
    "fastify-raw-body": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.15.5",
    "prisma": "^7.9.1",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vitest": "^4.0.9"
  }
}
